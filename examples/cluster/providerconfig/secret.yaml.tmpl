apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # Only wiz_url, wiz_auth_client_id and wiz_auth_client_secret are required.
  # Every other key is optional and maps 1:1 to a Terraform provider argument.
  # The native kinds (Project, User, ServiceAccount) read only wiz_auth_url,
  # wiz_auth_audience and http_client_retry_max of those, and use HTTPS_PROXY
  # instead of the proxy keys.
  credentials: |
    {
      "wiz_url": "https://api.<region>.app.wiz.io/graphql",
      "wiz_auth_client_id": "${WIZ_CLIENT_ID}",
      "wiz_auth_client_secret": "${WIZ_CLIENT_SECRET}"
    }
